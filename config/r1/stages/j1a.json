   "cmd": "D=\"$WORK/prod/estimates_M\" && rm -rf \"$D\" \"$STAGE_OUT/report_estimates_m.json\" \"$STAGE_OUT/stop_report_estimates_m.json\" && \"$PY\" -c 'import json, pathlib, shutil, sys\nd, rep = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2])\nsrcs, tsvs = [pathlib.Path(x) for x in sys.argv[3:7]], [pathlib.Path(x) for x in sys.argv[7:9]]\ndef names(t):\n    return [ln.split(\"\\t\")[4] for ln in t.read_text(encoding=\"utf-8\").splitlines()[1:] if ln.strip()]\ndef leaves(v):\n    if isinstance(v, str):\n        return [v]\n    vals = v.values() if isinstance(v, dict) else v if isinstance(v, list) else []\n    return [x for y in vals for x in leaves(y)]\ndef stop(code, items):\n    (rep / \"stop_report_estimates_m.json\").write_text(json.dumps({\"stage\": \"estimates_m\", \"result\": \"STOP\", \"code\": code, \"missing\": sorted(items)}, indent=1) + \"\\n\", encoding=\"utf-8\")\n    sys.exit(\"ESTIMATES_M STOP \" + code + \" \" + \" \".join(sorted(items)))\ndef matched(f):\n    v = leaves(json.loads(f.read_text(encoding=\"utf-8\")).get(\"point_estimate_check\"))\n    return bool(v) and all(x == \"MATCH\" for x in v)\nwant, evcl = names(tsvs[0]) + names(tsvs[1]), names(tsvs[1])\nhave, dup = {}, []\nfor s in srcs:\n    for f in sorted(s.glob(\"*.json\")):\n        if f.name in have:\n            dup.append(f.name)\n        have.setdefault(f.name, f)\nif dup:\n    stop(\"DUPLICATE\", dup)\nif set(want) - set(have):\n    stop(\"MISSING\", set(want) - set(have))\nif set(have) - set(want) or len(want) != len(set(want)):\n    stop(\"EXTRA\", set(have) - set(want))\nbad = [n for n in evcl if not matched(have[n])]\nif bad:\n    stop(\"EVCL_CHECK\", bad)\nd.mkdir(parents=True, exist_ok=True)\nfor n, f in sorted(have.items()):\n    shutil.copyfile(f, d / n)\n(rep / \"report_estimates_m.json\").write_text(json.dumps({\"stage\": \"estimates_m\", \"result\": \"OK\", \"n_cells\": len(have), \"n_evcl_checked\": len(evcl)}, indent=1) + \"\\n\", encoding=\"utf-8\")\nprint(\"ESTIMATES_M OK\", len(have))' \"$D\" \"$STAGE_OUT\" \"$WORK/prod/cells_rmac/estimates\" \"$WORK/prod/cells_rcloud/estimates\" \"$WORK/prod/cells_rmac_evcl/estimates\" \"$WORK/prod/cells_rcloud_evcl/estimates\" \"$REPO_DIR/config/r1/cells/M.tsv\" \"$REPO_DIR/config/r1/cells/M_evcl.tsv\"",
   "inputs": [
