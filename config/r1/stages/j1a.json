    "stage:cells_rmac_evcl",
    "stage:cells_rcloud_evcl",
    "repo:config/r1/cells/M.tsv",
    "repo:config/r1/cells/M_evcl.tsv",
    "env:py"
   ],
   "outputs": [
    "work:prod/estimates_M"
   ],
   "est_min": 1,
   "needs": [
    "cells_rmac",
    "cells_rcloud",
    "cells_rmac_evcl",
    "cells_rcloud_evcl"
   ]
  },
