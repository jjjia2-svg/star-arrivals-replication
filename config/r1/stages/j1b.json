   "inputs": [
    "repo:config/r1/layouts/j1b_from_j1a.json",
    "repo:pipeline/aws/r1/run_stages.py"
   ],
   "outputs": [
    "work:prod/restore_j1a"
   ],
   "est_min": 15,
   "needs": [
    "config"
   ],
   "resume": "always"
  },
  {
